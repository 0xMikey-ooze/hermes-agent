{
  "name": "muse-mcp",
  "version": "0.1.0",
  "description": "MCP server that feeds AI designers real-world inspiration, learns per-agent taste, and emits grounded design briefs.",
  "type": "module",
  "private": true,
  "bin": {
    "muse-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "cheerio": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "bun-types": "^1.1.34"
  },
  "engines": {
    "node": ">=20"
  }
}
