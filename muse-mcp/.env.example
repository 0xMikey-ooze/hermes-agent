# Required for intent parsing, style extraction, and brief synthesis.
ANTHROPIC_API_KEY=

# Model overrides (defaults are sensible).
MUSE_INTENT_MODEL=claude-haiku-4-5-20251001
MUSE_EXTRACTION_MODEL=claude-sonnet-4-6
MUSE_SYNTHESIS_MODEL=claude-sonnet-4-6

# Cache / store location (JSON file persistence). Defaults to .muse-cache/ in CWD.
MUSE_CACHE_DIR=

# Source toggles (comma separated). Default: landbook,godly,dribbble.
# Dribbble is great for category shots — barbershop, coffee shop, taqueria etc.
MUSE_SOURCES=landbook,godly,dribbble

# HTTP timeouts in ms.
MUSE_HTTP_TIMEOUT_MS=15000

# Per-call budgets.
MUSE_MAX_REFERENCES=60
MUSE_MAX_EXTRACT_CONCURRENCY=4
