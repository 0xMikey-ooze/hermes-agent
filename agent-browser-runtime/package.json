{
  "name": "@peopleppl/agent-browser",
  "version": "0.1.0-alpha.0",
  "description": "Headless EVM-aware browser runtime for autonomous agents. Combines Playwright + Anvil + an injected EIP-1193/6963 provider so agents can drive crypto dApps end-to-end without MetaMask popups.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    }
  },
  "bin": {
    "agent-browser": "./dist/cli.js",
    "agent-browser-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx tests/*.test.ts",
    "example:foxify": "tsx examples/foxify-flow.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@viem/anvil": "^0.0.10",
    "ethers": "^6.13.0",
    "playwright": "^1.47.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "evm",
    "ethereum",
    "agent",
    "headless",
    "browser",
    "playwright",
    "anvil",
    "eip-1193",
    "eip-6963",
    "mcp",
    "wallet",
    "dapp"
  ]
}
